{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "arxivexplorer",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-05-01",
  "compatibility_flags": ["nodejs_compat"],

  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },

  "kv_namespaces": [
    {
      "binding": "CACHE",
      "id": "ed3c323de9cc48a4b332beec939597a4"
    }
  ],

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "arxiv-explorer",
      "database_id": "67fa825b-9f3e-478c-99d2-3e5cc1b0f3de"
    }
  ],

  "vectorize": [
    {
      "binding": "VECTORIZE",
      "index_name": "arxiv-papers"
    }
  ],

  "ai": {
    "binding": "AI"
  },

  // The API handlers now run in-process inside page renders (helper/api.ts), so
  // this worker needs the same native rate-limit binding as wrangler.api.toml.
  // Without it the per-route limiter falls back to KV writes (1,000/day free).
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 120, "period": 60 }
    }
  ],

  "services": [
    {
      "binding": "API",
      "service": "arxiv-api"
    }
  ],

  "observability": {
    "enabled": true
  },

  "vars": {
    "API_BASE": "https://arxiv-api.arxivexplorer.workers.dev",
    "ALLOWED_ORIGIN": "https://arxivexplorer.arxivexplorer.workers.dev",
    "ARXIV_FETCH_CATEGORIES": "cs.LG,cs.CL,cs.CV,stat.ML",
    "EMBEDDING_MODEL": "@cf/baai/bge-base-en-v1.5",
    "CACHE_TTL_SEARCH_SECONDS": "7200",
    "CACHE_TTL_TRENDING_SECONDS": "3600",
    "CACHE_TTL_EMBED_SECONDS": "86400",
    // Public by design: this value is served in the page HTML to every browser,
    // so committing it leaks nothing. The credential is TURNSTILE_SECRET
    // (`wrangler secret put`), never a var. Either empty => gate fails open.
    "TURNSTILE_SITE_KEY": "0x4AAAAAAGGu6a6NDEiSX031"
  }
}
